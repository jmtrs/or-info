{
  "manifest_version": "0.3",
  "name": "or-info",
  "display_name": "OpenRouter Info",
  "version": "0.2.7",
  "description": "CLI + MCP server for OpenRouter models: prices, benchmarks, context and comparisons",
  "long_description": "Query OpenRouter model catalog and LMArena ELO rankings. Compare models, list best-for-task, get pricing and context length. No API key required for public catalog; optional OPENROUTER_API_KEY for private/pay-gated models.",
  "author": {
    "name": "jmtrs",
    "url": "https://github.com/jmtrs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jmtrs/or-info.git"
  },
  "homepage": "https://github.com/jmtrs/or-info#readme",
  "documentation": "https://github.com/jmtrs/or-info#readme",
  "support": "https://github.com/jmtrs/or-info/issues",
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "openrouter",
    "llm",
    "ai",
    "mcp",
    "benchmarks",
    "pricing"
  ],
  "server": {
    "type": "node",
    "entry_point": "bin/or-info.mjs",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/bin/or-info.mjs",
        "--mcp"
      ],
      "env": {
        "OPENROUTER_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "OpenRouter API Key",
      "description": "Optional. Provides access to private/pay-gated models and higher rate limits.",
      "sensitive": true,
      "required": false
    }
  },
  "tools": [
    {
      "name": "get_model_info",
      "description": "Get pricing, context length, architecture and features for a specific OpenRouter model",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string",
            "description": "OpenRouter model ID, e.g. \"anthropic/claude-sonnet-4-5\""
          }
        },
        "required": [
          "model_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "input_per_m": {
            "type": [
              "number",
              "null"
            ],
            "description": "Input price per 1M tokens (USD)"
          },
          "output_per_m": {
            "type": [
              "number",
              "null"
            ],
            "description": "Output price per 1M tokens (USD)"
          },
          "image_per_m": {
            "type": [
              "number",
              "null"
            ]
          },
          "cache_read_per_m": {
            "type": [
              "number",
              "null"
            ]
          },
          "context_length": {
            "type": [
              "integer",
              "null"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "modality": {
            "type": [
              "string",
              "null"
            ]
          },
          "tokenizer": {
            "type": [
              "string",
              "null"
            ]
          },
          "max_output_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "supported_parameters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lmarena_elo": {
            "type": [
              "object",
              "null"
            ],
            "description": "LMArena ELO entry or null when not tracked"
          }
        }
      },
      "annotations": {
        "title": "Get model info",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "list_models",
      "description": "List OpenRouter models with pricing. Optionally filter by name/id, sort, and limit results.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "string",
            "description": "Case-insensitive substring to match against model ID or name"
          },
          "sort_by": {
            "type": "string",
            "enum": [
              "name",
              "price",
              "context"
            ],
            "description": "Sort order",
            "default": "name"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "Max models to return (default 50)"
          },
          "free_only": {
            "type": "boolean",
            "description": "Return only free models"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "input_per_m": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Input price per 1M tokens (USD)"
                },
                "output_per_m": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Output price per 1M tokens (USD)"
                },
                "image_per_m": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "cache_read_per_m": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "context_length": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "modality": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tokenizer": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "max_output_tokens": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "supported_parameters": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "required": [
          "total",
          "models"
        ]
      },
      "annotations": {
        "title": "List models",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_benchmarks",
      "description": "Get LMArena ELO ranking for a model: score, global rank, vote count and confidence interval",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string",
            "description": "OpenRouter model ID"
          }
        },
        "required": [
          "model_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string"
          },
          "lmarena_elo": {
            "type": [
              "object",
              "null"
            ],
            "description": "LMArena ELO entry or null when not tracked"
          }
        },
        "required": [
          "model_id"
        ]
      },
      "annotations": {
        "title": "Get benchmarks",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "compare_models",
      "description": "Side-by-side comparison of two models: pricing, context, benchmarks and features",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_a": {
            "type": "string",
            "description": "First OpenRouter model ID"
          },
          "model_b": {
            "type": "string",
            "description": "Second OpenRouter model ID"
          }
        },
        "required": [
          "model_a",
          "model_b"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "input_per_m": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Input price per 1M tokens (USD)"
              },
              "output_per_m": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Output price per 1M tokens (USD)"
              },
              "image_per_m": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "cache_read_per_m": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "context_length": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "modality": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tokenizer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "max_output_tokens": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "supported_parameters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lmarena_elo": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "LMArena ELO entry or null when not tracked"
              }
            }
          },
          "b": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "input_per_m": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Input price per 1M tokens (USD)"
              },
              "output_per_m": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Output price per 1M tokens (USD)"
              },
              "image_per_m": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "cache_read_per_m": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "context_length": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "modality": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tokenizer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "max_output_tokens": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "supported_parameters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lmarena_elo": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "LMArena ELO entry or null when not tracked"
              }
            }
          }
        },
        "required": [
          "a",
          "b"
        ]
      },
      "annotations": {
        "title": "Compare models",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "best_for_task",
      "description": "Rank the best models for a specific task, optionally within a price budget",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "coding",
              "reasoning",
              "general",
              "vision",
              "cheap"
            ],
            "description": "Task type to optimise for"
          },
          "max_price_per_m_output": {
            "type": "number",
            "description": "Maximum price per 1M output tokens in USD (e.g. 1.0)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Number of results (default 5)"
          }
        },
        "required": [
          "task"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "input_per_m": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Input price per 1M tokens (USD)"
                },
                "output_per_m": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Output price per 1M tokens (USD)"
                },
                "image_per_m": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "cache_read_per_m": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "context_length": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "modality": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tokenizer": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "max_output_tokens": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "supported_parameters": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "score": {
                  "type": "number"
                },
                "lmarena_elo": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "LMArena ELO entry or null when not tracked"
                }
              }
            }
          }
        },
        "required": [
          "task",
          "results"
        ]
      },
      "annotations": {
        "title": "Best models for task",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "refresh_cache",
      "description": "Force-refresh the local cache: OpenRouter model catalog + LMArena ELO data",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "refreshed": {
            "type": "boolean"
          },
          "models_count": {
            "type": "integer"
          },
          "elo_entries": {
            "type": "integer"
          }
        },
        "required": [
          "refreshed",
          "models_count",
          "elo_entries"
        ]
      },
      "annotations": {
        "title": "Refresh cache",
        "readOnlyHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    }
  ],
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": ">=22.0.0"
    }
  }
}
